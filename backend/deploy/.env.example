# Compose 项目标识和镜像标签
COMPOSE_PROJECT_NAME=data-chain-demo
IMAGE_TAG=demo

# 前端源码目录和 Dockerfile 路径；Dockerfile 路径相对于构建上下文
FRONTEND_BUILD_CONTEXT=../../data-chain-static
FRONTEND_DOCKERFILE=../data-chain/deploy/frontend.Dockerfile

# 对外访问端口；服务器 80 端口未被占用时可直接使用 80
HTTP_PORT=18080

# 前端 Origin；请改成实际访问地址，例如 http://192.168.1.20:18080
WSC_CORS_ALLOWED_ORIGINS=http://localhost:18080

# 时区
TZ=Asia/Shanghai
