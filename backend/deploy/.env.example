# Compose 项目标识和镜像标签
COMPOSE_PROJECT_NAME=data-chain-demo
IMAGE_TAG=demo

# 前端源码目录和 Dockerfile 路径；Dockerfile 路径相对于构建上下文
FRONTEND_BUILD_CONTEXT=../../data-chain-static
FRONTEND_DOCKERFILE=../data-chain/deploy/frontend.Dockerfile

# 对外访问端口；服务器 80 端口未被占用时可直接使用 80
HTTP_PORT=18080

# 前端 Origin；请改成实际访问地址，例如 http://192.168.1.20:18080
WSC_CORS_ALLOWED_ORIGINS=http://localhost:18080

# 时区
# ChainMP 信息存证。真实凭证仅填写在服务器 deploy/.env，禁止提交到仓库。
# 是否调用真实 ChainMP：false=不请求远端，true=提交并轮询真实上链结果。
CHAINMP_ENABLED=true
# 是否允许 mock：真实链关闭时可直接 mock；真实链开启时可在重试耗尽后降级 mock。
# 正式环境不允许模拟凭证时请设置为 false。
CHAINMP_MOCK_ENABLED=true
CHAINMP_SUBMIT_MAX_ATTEMPTS=3
CHAINMP_QUERY_MAX_ATTEMPTS=5
CHAINMP_RETRY_DELAY_MILLIS=2000

TZ=Asia/Shanghai
